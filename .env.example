# =============================================================================
# AI Security Gateway — environment configuration
# Copy to `.env` and adjust. NEVER commit a real .env file.
# All values below are SAFE DEVELOPMENT DEFAULTS (no credentials).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL + pgvector) ----------------------------------------
# Docker Compose default (host port 5433 to avoid clashing with any local
# PostgreSQL service already using 5432):
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5433/ai_security_gateway
DB_ECHO=false
DATABASE_TIMEOUT_SECONDS=10

# --- Security / Auth ---------------------------------------------------------
# JWT secret: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-generate-a-real-secret-before-any-real-use
JWT_EXPIRATION_MINUTES=480
# Bootstrap admin credentials are read from env on first startup.
# CHANGE THESE before any use beyond local development.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me-admin-password
# Access token will not be accepted from these origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

# --- LLM provider ------------------------------------------------------------
LLM_PROVIDER=ollama           # ollama | openai | anthropic (openai/anthropic are future stubs)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_CONTEXT_LENGTH=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1024
# Optional API providers (never commit real keys; only used if LLM_PROVIDER changes)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM semantic classification hook (uses the LLM to double-check injections; adds latency)
LLM_SECURITY_CLASSIFIER_ENABLED=false

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_SECONDS=60

# --- RAG ---------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.15
MAX_UPLOAD_SIZE_MB=20
DUPLICATE_ACTION=REUSE          # REUSE | REJECT | REPROCESS

# --- Risk thresholds (initial policy values — require empirical evaluation) ---
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60
RISK_THRESHOLD_CRITICAL=0.80

# --- Privacy / retention -----------------------------------------------------
STORE_RAW_PROMPTS=true          # local development convenience; document privacy impact
STORE_RAW_OUTPUTS=true
AUDIT_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=180
